#!/bin/sh
# shellcheck shell=ash

# Variables are populated by sourced SafeShield helpers and ss_load_config().
# shellcheck disable=SC2154
LC_ALL=C
export LC_ALL

SS_STATSD_FUNCTIONS_LIB="${SS_STATSD_FUNCTIONS_LIB:-/lib/functions.sh}"
SS_STATSD_CORE_LIB="${SS_STATSD_CORE_LIB:-/usr/lib/safeshield/core.sh}"
SS_STATSD_AWK_PROGRAM="${SS_STATSD_AWK_PROGRAM:-/usr/lib/safeshield/statistics.awk}"

# shellcheck disable=SC1090
. "$SS_STATSD_FUNCTIONS_LIB"
# shellcheck disable=SC1090
. "$SS_STATSD_CORE_LIB"

stats_logread_pid=''
stats_awk_pid=''
stats_fifo=''
stats_lock_dir=''
stats_lock_owned=0

stats_process_running() {
	local pid="${1:-}"
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null
}

stats_cleanup() {
	trap - EXIT HUP INT TERM

	if stats_process_running "$stats_logread_pid"; then
		kill "$stats_logread_pid" 2>/dev/null || true
	fi
	if stats_process_running "$stats_awk_pid"; then
		kill "$stats_awk_pid" 2>/dev/null || true
	fi

	[ -n "$stats_logread_pid" ] && wait "$stats_logread_pid" 2>/dev/null || true
	[ -n "$stats_awk_pid" ] && wait "$stats_awk_pid" 2>/dev/null || true

	[ -n "$stats_fifo" ] && rm -f "$stats_fifo"

	if [ "$stats_lock_owned" -eq 1 ] && [ -n "$stats_lock_dir" ]; then
		rm -rf "$stats_lock_dir"
	fi
}

stats_terminate() {
	local rc="${1:-0}"
	stats_cleanup
	exit "$rc"
}

stats_acquire_lock() {
	local owner_pid=''

	stats_lock_dir="${SS_STATISTICS_DIR}/collector.lock"

	if mkdir "$stats_lock_dir" 2>/dev/null; then
		stats_lock_owned=1
		printf '%s\n' "$$" >"${stats_lock_dir}/pid"
		return 0
	fi

	if [ -r "${stats_lock_dir}/pid" ]; then
		owner_pid="$(cat "${stats_lock_dir}/pid" 2>/dev/null || true)"
	fi

	if stats_process_running "$owner_pid"; then
		log_warn "Statistics collector is already running (pid=${owner_pid})"
		return 1
	fi

	log_warn 'Removing stale statistics collector lock'
	rm -rf "$stats_lock_dir" || return 1
	mkdir "$stats_lock_dir" || return 1
	stats_lock_owned=1
	printf '%s\n' "$$" >"${stats_lock_dir}/pid"
	return 0
}

stats_run_collector() {
	local snapshot_interval="$1"
	local retention_hours="$2"
	local rc=0

	stats_fifo="${SS_STATISTICS_DIR}/events.$$"
	rm -f "$stats_fifo"
	mkfifo "$stats_fifo" || {
		log_error "Failed to create statistics FIFO: ${stats_fifo}"
		return 1
	}

	logread -f -l 0 >"$stats_fifo" &
	stats_logread_pid=$!

	awk \
		-v state_file="${SS_STATISTICS_STATE_FILE}" \
		-v json_file="${SS_STATISTICS_JSON_FILE}" \
		-v snapshot_interval="${snapshot_interval}" \
		-v retention_hours="${retention_hours}" \
		-f "$SS_STATSD_AWK_PROGRAM" \
		<"$stats_fifo" &
	stats_awk_pid=$!

	wait "$stats_awk_pid" || rc=$?
	stats_awk_pid=''

	if stats_process_running "$stats_logread_pid"; then
		kill "$stats_logread_pid" 2>/dev/null || true
	fi
	wait "$stats_logread_pid" 2>/dev/null || true
	stats_logread_pid=''

	return "$rc"
}

main() {
	local snapshot_interval retention_hours rc=0

	ss_load_config || return 1
	[ "${ss_enabled}" = "1" ] || return 0
	[ "${ss_statistics_enabled}" = "1" ] || return 0

	command_exists logread || {
		log_error 'logread is required for SafeShield statistics'
		return 1
	}
	command_exists mkfifo || {
		log_error 'mkfifo is required for SafeShield statistics'
		return 1
	}

	mkdir -p "${SS_STATISTICS_DIR}" || return 1
	stats_acquire_lock || return 0

	trap 'stats_cleanup' EXIT
	trap 'stats_terminate 129' HUP
	trap 'stats_terminate 130' INT
	trap 'stats_terminate 143' TERM

	snapshot_interval="${ss_statistics_snapshot_interval_s}"
	retention_hours="${ss_statistics_retention_hours}"

	log_info "Starting statistics collector (snapshot=${snapshot_interval}s retention=${retention_hours}h)"

	stats_run_collector "$snapshot_interval" "$retention_hours" || rc=$?
	return "$rc"
}

main "$@"
